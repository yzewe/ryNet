<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/vnd.rynet.plugin">
    <comment>ryNet plugin</comment>
    <comment xml:lang="ru">Плагин ryNet</comment>
    <icon name="rynet"/>
    <glob pattern="*.rnp"/>
    <magic priority="80">
      <match type="string" offset="0" value="\x89RNP\r\n\x1a"/>
    </magic>
  </mime-type>
</mime-info>
